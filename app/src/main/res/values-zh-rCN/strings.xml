    <string name="settings_reliability_vendor_title">%1$s 步骤</string>
    <string name="settings_reliability_vendor_body_oneplus">在 OxygenOS 上，从应用信息 -&gt; 电池用量开始，如果隧道仍停止，还需检查睡眠待机优化、深度优化和最近任务锁定</string>
    <string name="settings_reliability_vendor_body_coloros">ColorOS 和 realme UI 通常将此分为后台活动、前台活动、自启动和最近任务锁定。请启用所有可见的选项</string>
    <string name="settings_reliability_vendor_body_xiaomi">MIUI 和 HyperOS 通常需要同时设置无限制和自启动。某些版本还会停止未在最近任务中锁定的应用</string>
    <string name="settings_reliability_vendor_body_huawei">EMUI 和 MagicOS 通常需要手动管理应用启动。请为 Bedlam 启用所有启动/后台开关</string>
    <string name="settings_reliability_vendor_body_vivo">vivo 和 iQOO 固件通常将自启动与后台功耗分开。Bedlam 需要两者都允许</string>
    <string name="settings_reliability_vendor_body_generic_aggressive">此厂商有时会添加额外的电池管理器。请查找 Bedlam 的后台活动、自启动、受保护应用或省电模式</string>
    <string name="settings_reliability_vendor_body_samsung">三星对前台 VPN 通常没问题。仅在手机开始休眠 Bedlam 时使用这些步骤</string>
    <string name="settings_reliability_vendor_body_normal">未检测到特殊厂商设置。保持 Android 电池优化已允许，如需自动重启请使用始终开启 VPN</string>
    <string name="settings_reliability_explain_title">为什么 Bedlam 无法自动完成</string>
    <string name="settings_reliability_explain_body">Android 允许 Bedlam 请求标准电池例外，但许多厂商添加了无公开 API 的私有电池管理器。Bedlam 可以打开相关设置并说明路径；只有您可以批准厂商特定的开关</string>

    <string-array name="settings_reliability_steps_oneplus">
        <item>打开 Bedlam 应用信息</item>
        <item>点击电池用量或电池</item>
        <item>选择无限制或允许后台活动</item>
        <item>如果 Bedlam 仍停止，请禁用睡眠待机优化或深度优化</item>
        <item>如果可见，请在最近任务中锁定 Bedlam，防止 OxygenOS 清除它</item>
    </string-array>
    <string-array name="settings_reliability_steps_coloros">
        <item>打开 Bedlam 应用信息</item>
        <item>打开电池用量或应用电池管理</item>
        <item>允许后台活动和前台活动</item>
        <item>如果手机显示自启动开关，请启用</item>
        <item>如果 ColorOS 持续清除隧道，请在最近任务中锁定 Bedlam</item>
    </string-array>
    <string-array name="settings_reliability_steps_xiaomi">
        <item>打开 Bedlam 应用信息</item>
        <item>打开省电模式并选择无限制</item>
        <item>打开自启动并启用 Bedlam</item>
        <item>如果隧道仍停止，请在最近任务中锁定 Bedlam</item>
    </string-array>
    <string-array name="settings_reliability_steps_huawei">
        <item>打开电池 -&gt; 应用启动</item>
        <item>找到 Bedlam 并禁用自动管理</item>
        <item>启用自启动、关联启动和后台运行</item>
        <item>确认更改并重连隧道</item>
    </string-array>
    <string-array name="settings_reliability_steps_vivo">
        <item>打开自启动并启用 Bedlam</item>
        <item>打开电池或后台耗电</item>
        <item>允许 Bedlam 在后台运行</item>
        <item>更改设置后重连隧道</item>
    </string-array>
    <string-array name="settings_reliability_steps_generic_aggressive">
        <item>打开 Bedlam 应用信息</item>
        <item>将电池设置为无限制</item>
        <item>如果可用，启用自启动或受保护应用</item>
        <item>允许 Bedlam 后台活动</item>
    </string-array>
    <string-array name="settings_reliability_steps_samsung">
        <item>打开 Bedlam 应用信息</item>
        <item>如果 Bedlam 被停止，将电池设置为无限制</item>
        <item>在后台使用限制中，如有需要，将 Bedlam 添加到永不休眠应用</item>
    </string-array>
    <string-array name="settings_reliability_steps_normal">
        <item>允许 Android 电池优化例外</item>
        <item>如需开机后自动重启，请启用始终开启 VPN</item>
        <item>隧道活跃时保持 Bedlam 通知已允许</item>
    </string-array>

